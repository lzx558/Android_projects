<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Android_test1">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Android_test1"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 实验1：线性布局 -->
        <activity
            android:name=".LinearLayoutActivity"
            android:exported="false"
            android:label="线性布局"
            android:theme="@style/Theme.Android_test1.AppCompat" />

        <!-- 实验2：表格布局 -->
        <activity
            android:name=".TableLayoutActivity"
            android:exported="false"
            android:label="表格布局"
            android:theme="@style/Theme.Android_test1.AppCompat" />

        <!-- 实验3：约束布局1——计算器 -->
        <activity
            android:name=".CalculatorActivity"
            android:exported="false"
            android:label="ConstraintLayoutTest"
            android:theme="@style/Theme.Android_test1.AppCompat" />

        <!-- 实验4：约束布局2——太空旅行 -->
        <activity
            android:name=".SpaceTravelActivity"
            android:exported="false"
            android:label="Flights"
            android:theme="@style/Theme.Android_test1.AppCompat" />

        <!-- 实验5：Android Compose 任务列表 -->
        <activity
            android:name=".ComposeTaskActivity"
            android:exported="false"
            android:label="课程学习任务"
            android:windowSoftInputMode="adjustResize" />

        <!-- 实验3-1：ListView + SimpleAdapter -->
        <activity
            android:name=".ListViewActivity"
            android:exported="false"
            android:label="ListView"
            android:theme="@style/Theme.Android_test1.AppCompat" />

        <!-- 实验3-2：自定义 AlertDialog -->
        <activity
            android:name=".AlertDialogActivity"
            android:exported="false"
            android:label="AlertDialog"
            android:theme="@style/Theme.Android_test1.AppCompat" />

        <!-- 实验3-3：XML 菜单 -->
        <activity
            android:name=".MenuTestActivity"
            android:exported="false"
            android:label="MenuTest"
            android:theme="@style/Theme.Android_test1.AppCompat.ActionBar" />

        <!-- 实验3-4：ActionMode 上下文菜单 -->
        <activity
            android:name=".ActionModeActivity"
            android:exported="false"
            android:label="ActionMode"
            android:theme="@style/Theme.Android_test1.AppCompat" />

        <!-- 实验3-5：RecyclerView -->
        <activity
            android:name=".RecyclerViewActivity"
            android:exported="false"
            android:label="RecyclerView"
            android:theme="@style/Theme.Android_test1.AppCompat" />
    </application>

</manifest>