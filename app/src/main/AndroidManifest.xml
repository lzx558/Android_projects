<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Android_test1">

        <!-- 入口：实验总菜单 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Android_test1"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ==================================================
             实验二：Android 界面布局（com.example.android_test1.lab2）
             ================================================== -->

        <!-- 实验二 · 01 线性布局 -->
        <activity
            android:name=".lab2.LinearLayoutActivity"
            android:exported="false"
            android:label="线性布局"
            android:theme="@style/Theme.Android_test1.AppCompat" />

        <!-- 实验二 · 02 表格布局 -->
        <activity
            android:name=".lab2.TableLayoutActivity"
            android:exported="false"
            android:label="表格布局"
            android:theme="@style/Theme.Android_test1.AppCompat" />

        <!-- 实验二 · 03 约束布局（一）计算器 -->
        <activity
            android:name=".lab2.CalculatorActivity"
            android:exported="false"
            android:label="ConstraintLayoutTest"
            android:theme="@style/Theme.Android_test1.AppCompat" />

        <!-- 实验二 · 04 约束布局（二）太空旅行 -->
        <activity
            android:name=".lab2.SpaceTravelActivity"
            android:exported="false"
            android:label="Flights"
            android:theme="@style/Theme.Android_test1.AppCompat" />

        <!-- 实验二 · 05 Android Compose 任务列表 -->
        <activity
            android:name=".lab2.ComposeTaskActivity"
            android:exported="false"
            android:label="课程学习任务"
            android:windowSoftInputMode="adjustResize" />

        <!-- ==================================================
             实验三：事件处理 · 列表 · 对话框 · 菜单（com.example.android_test1.lab3）
             ================================================== -->

        <!-- 实验三 · 01 ListView + SimpleAdapter -->
        <activity
            android:name=".lab3.ListViewActivity"
            android:exported="false"
            android:label="ListView"
            android:theme="@style/Theme.Android_test1.AppCompat" />

        <!-- 实验三 · 02 自定义 AlertDialog -->
        <activity
            android:name=".lab3.AlertDialogActivity"
            android:exported="false"
            android:label="AlertDialog"
            android:theme="@style/Theme.Android_test1.AppCompat" />

        <!-- 实验三 · 03 XML 菜单 -->
        <activity
            android:name=".lab3.MenuTestActivity"
            android:exported="false"
            android:label="MenuTest"
            android:theme="@style/Theme.Android_test1.AppCompat.ActionBar" />

        <!-- 实验三 · 04 ActionMode 上下文菜单 -->
        <activity
            android:name=".lab3.ActionModeActivity"
            android:exported="false"
            android:label="ActionMode"
            android:theme="@style/Theme.Android_test1.AppCompat" />

        <!-- 实验三 · 05 RecyclerView -->
        <activity
            android:name=".lab3.RecyclerViewActivity"
            android:exported="false"
            android:label="RecyclerView"
            android:theme="@style/Theme.Android_test1.AppCompat" />

        <!-- ==================================================
             期中考试：NotePad 记事本应用（com.example.android_test1.midterm）
             ================================================== -->

        <!-- 笔记数据仓库：ContentProvider + SQLite，仅本应用内部使用 -->
        <provider
            android:name=".midterm.NotePadProvider"
            android:authorities="com.example.android_test1.notepad"
            android:exported="false" />

        <!-- 导出笔记时用于分享 txt 文件 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.midterm.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/midterm_file_paths" />
        </provider>

        <!-- 期中考试 · 01 笔记列表 -->
        <activity
            android:name=".midterm.NotesList"
            android:exported="false"
            android:label="@string/midterm_title_notes_list"
            android:theme="@style/Theme.Android_test1.Midterm" />

        <!-- 期中考试 · 02 笔记编辑 -->
        <activity
            android:name=".midterm.NoteEditor"
            android:exported="false"
            android:label="@string/midterm_title_edit"
            android:theme="@style/Theme.Android_test1.Midterm"
            android:windowSoftInputMode="adjustResize" />

        <!-- 期中考试 · 03 修改标题 -->
        <activity
            android:name=".midterm.TitleEditor"
            android:exported="false"
            android:label="@string/midterm_title_edit_title"
            android:theme="@style/Theme.Android_test1.Midterm.Dialog"
            android:windowSoftInputMode="stateVisible" />

        <!-- 期中考试 · 04 偏好设置 -->
        <activity
            android:name=".midterm.NoteSettings"
            android:exported="false"
            android:label="@string/midterm_title_settings"
            android:theme="@style/Theme.Android_test1.Midterm" />

    </application>

</manifest>
